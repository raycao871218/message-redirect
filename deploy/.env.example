# Compose publication examples; actual values stay in ignored .env.
SMS_BIND_ADDRESS=127.0.0.1
SMS_HTTP_PORT=18081
# Optional initial address for App pairing; can also be saved in the web panel.
SMS_PUBLIC_URL=
SMS_DB_NAME=sms_archive
SMS_DB_USER=sms_ingest
# Used by compose.external.example.yaml; match private config file permissions.
SMS_UID=10001
SMS_GID=10001
